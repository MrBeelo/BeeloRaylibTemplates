GuiLoadStyleCyber :: proc() {
	for i in 0..<CYBER_STYLE_PROPS_COUNT {
		rl.GuiSetStyle(cyberStyleProps[i].controlId, i32(cyberStyleProps[i].propertyId), i32(cyberStyleProps[i].propertyValue))
	}

	cyberFontDataSize := i32(0)
	data := rl.DecompressData(&cyberFontData[0], CYBER_STYLE_FONT_ATLAS_COMP_SIZE, &cyberFontDataSize)
	imFont := rl.Image{data, 512, 256, 1, .UNCOMPRESSED_GRAY_ALPHA}

	font: rl.Font
	font.baseSize = 14
	font.glyphCount = 188

	rec_ptr, rec_err := mem.alloc(int(font.glyphCount) * size_of(rl.Rectangle))
	if rec_err != nil do panic("Font rec allocation error!")
	font.recs = cast([^]rl.Rectangle)rec_ptr
	copy(font.recs[:font.glyphCount], cyberFontRecs[:font.glyphCount])

	glyph_ptr, glyph_err := mem.alloc(int(font.glyphCount) * size_of(rl.GlyphInfo))
	if glyph_err != nil do panic("Font glyph allocation error!")
	font.glyphs = cast([^]rl.GlyphInfo)glyph_ptr
	copy(font.glyphs[:font.glyphCount], cyberFontGlyphs[:font.glyphCount])

	fontWhiteRec := rl.Rectangle{510, 254, 1, 1}

	font.texture = rl.LoadTextureFromImage(imFont)
	rl.UnloadImage(imFont)

	rl.GuiSetFont(font)

	rl.SetShapesTexture(font.texture, fontWhiteRec)
}